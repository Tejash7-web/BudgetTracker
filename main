using System;
using System.Data;
using System.Drawing;
using System.Windows.Forms;
using MySql.Data.MySqlClient;

namespace PersonalBudgetTracker
{

    public abstract class DatabaseManager
    {
        protected string ConnectionString { get; set; }

        public DatabaseManager(string connectionString)
        {
            ConnectionString = connectionString;
        }

        public abstract DataTable LoadData(string query);

        public abstract void ExecuteNonQuery(string query, MySqlParameter[] parameters);
    }

    public class MySqlDatabaseManager : DatabaseManager
    {
        public MySqlDatabaseManager(string connectionString) : base(connectionString) { }

        public override DataTable LoadData(string query)
        {
            DataTable dt = new DataTable();
            using (MySqlConnection conn = new MySqlConnection(ConnectionString))
            {
                conn.Open();
                using (MySqlDataAdapter adapter = new MySqlDataAdapter(query, conn))
                {
                    adapter.Fill(dt);
                }
            }
            return dt;
        }

        public override void ExecuteNonQuery(string query, MySqlParameter[] parameters)
        {
            using (MySqlConnection conn = new MySqlConnection(ConnectionString))
            {
                conn.Open();
                using (MySqlCommand cmd = new MySqlCommand(query, conn))
                {
                    if (parameters != null)
                    {
                        cmd.Parameters.AddRange(parameters);
                    }
                    cmd.ExecuteNonQuery();
                }
            }
        }
    }

    public class TransactionModel
    {
        public decimal Amount { get; set; }
        public int CategoryId { get; set; }
        public int TypeId { get; set; }
        public DateTime Date { get; set; }
        public string Description { get; set; }
    }

    public partial class MainForm : Form
    {
        private readonly DatabaseManager dbManager;

        // UI Controls
        private TextBox txtAmount;
        private TextBox txtDescription;
        private ComboBox cmbCategory;
        private ComboBox cmbType;
        private DateTimePicker dtpDate;
        private Button btnAdd;
        private Button btnDelete;
        private DataGridView dgvTransactions;
        private Label lblTotalIncome;
        private Label lblTotalExpenses;
        private Label lblRemainingBalance;
        private Label lblAmount;
        private Label lblCategory;
        private Label lblType;
        private Label lblDate;
        private Label lblDescription;

        public MainForm()
        {
            InitializeComponentManual();

            string connStr = "Server=localhost;Database=PersonalBudgetDB;Uid=root;Pw=;";
            dbManager = new MySqlDatabaseManager(connStr);

            LoadCategories();
            LoadTypes();
            LoadTransactions();
            UpdateSummary();
        }

        private void InitializeComponentManual()
        {
            this.Text = "Personal Budget Tracker";
            this.Size = new Size(800, 600);
            this.StartPosition = FormStartPosition.CenterScreen;

            // Labels
            lblAmount = new Label() { Text = "Amount:", Location = new Point(20, 20), AutoSize = true };
            lblCategory = new Label() { Text = "Category:", Location = new Point(20, 60), AutoSize = true };
            lblType = new Label() { Text = "Type:", Location = new Point(20, 100), AutoSize = true };
            lblDate = new Label() { Text = "Date:", Location = new Point(20, 140), AutoSize = true };
            lblDescription = new Label() { Text = "Description:", Location = new Point(20, 180), AutoSize = true };

            // Input fields
            txtAmount = new TextBox() { Location = new Point(120, 20), Width = 180 };
            cmbCategory = new ComboBox() { Location = new Point(120, 60), Width = 180, DropDownStyle = ComboBoxStyle.DropDownList };
            cmbType = new ComboBox() { Location = new Point(120, 100), Width = 180, DropDownStyle = ComboBoxStyle.DropDownList };
            dtpDate = new DateTimePicker() { Location = new Point(120, 140), Width = 180 };
            txtDescription = new TextBox() { Location = new Point(120, 180), Width = 180, Multiline = true, Height = 50 };

            // Buttons
            btnAdd = new Button() { Text = "Add Transaction", Location = new Point(20, 250), Width = 130, Height = 30 };
            btnDelete = new Button() { Text = "Delete Selected", Location = new Point(170, 250), Width = 130, Height = 30 };

            btnAdd.Click += new EventHandler(BtnAddClick);
            btnDelete.Click += new EventHandler(BtnDeleteClick);

            // DataGridView for transaction history
            dgvTransactions = new DataGridView()
            {
                Location = new Point(320, 20),
                Size = new Size(440, 430),
                ReadOnly = true,
                SelectionMode = DataGridViewSelectionMode.FullRowSelect,
                MultiSelect = false,
                AutoSizeColumnsMode = DataGridViewAutoSizeColumnsMode.Fill
            };
            
            lblTotalIncome = new Label() { Text = "Total Income: $0.00", Location = new Point(20, 310), AutoSize = true, Font = new Font(this.Font, FontStyle.Bold) };
            lblTotalExpenses = new Label() { Text = "Total Expenses: $0.00", Location = new Point(20, 340), AutoSize = true, Font = new Font(this.Font, FontStyle.Bold) };
            lblRemainingBalance = new Label() { Text = "Remaining Balance: $0.00", Location = new Point(20, 370), AutoSize = true, Font = new Font(this.Font, FontStyle.Bold) };

            // Add all controls to form
            this.Controls.Add(lblAmount);
            this.Controls.Add(txtAmount);
            this.Controls.Add(lblCategory);
            this.Controls.Add(cmbCategory);
            this.Controls.Add(lblType);
            this.Controls.Add(cmbType);
            this.Controls.Add(lblDate);
            this.Controls.Add(dtpDate);
            this.Controls.Add(lblDescription);
            this.Controls.Add(txtDescription);
            this.Controls.Add(btnAdd);
            this.Controls.Add(btnDelete);
            this.Controls.Add(dgvTransactions);
            this.Controls.Add(lblTotalIncome);
            this.Controls.Add(lblTotalExpenses);
            this.Controls.Add(lblRemainingBalance);
        }

        private void LoadCategories()
        {
            try
            {
                DataTable dt = dbManager.LoadData("SELECT CategoryID, Name FROM Category");
                cmbCategory.DataSource = dt;
                cmbCategory.DisplayMember = "Name";
                cmbCategory.ValueMember = "CategoryID";
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error loading categories: " + ex.Message);
            }
        }

        private void LoadTypes()
        {
            try
            {
                DataTable dt = dbManager.LoadData("SELECT TypeID, Name FROM Type");
                cmbType.DataSource = dt;
                cmbType.DisplayMember = "Name";
                cmbType.ValueMember = "TypeID";
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error loading transaction types: " + ex.Message);
            }
        }

        private void LoadTransactions()
        {
            try
            {
                string query = @"SELECT t.TransactionID, t.Amount, c.Name AS Category, 
                                        tp.Name AS Type, t.Date, t.Description 
                                 FROM Transaction t
                                 LEFT JOIN Category c ON t.CategoryID = c.CategoryID
                                 LEFT JOIN Type tp ON t.TypeID = tp.TypeID
                                 ORDER BY t.Date DESC";

                dgvTransactions.DataSource = dbManager.LoadData(query);
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error loading transactions: " + ex.Message);
            }
        }

        private void UpdateSummary()
        {
            decimal totalIncome = 0;
            decimal totalExpenses = 0;

            try
            {
                DataTable incomeDt = dbManager.LoadData("SELECT IFNULL(SUM(Amount), 0) FROM Transaction WHERE TypeID = 1");
                if (incomeDt.Rows.Count > 0 && incomeDt.Rows[0][0] != DBNull.Value)
                    totalIncome = Convert.ToDecimal(incomeDt.Rows[0][0]);

                DataTable expenseDt = dbManager.LoadData("SELECT IFNULL(SUM(Amount), 0) FROM Transaction WHERE TypeID = 2");
                if (expenseDt.Rows.Count > 0 && expenseDt.Rows[0][0] != DBNull.Value)
                    totalExpenses = Convert.ToDecimal(expenseDt.Rows[0][0]);
            }
            catch (Exception ex)
            {
                MessageBox.Show("Error calculating totals: " + ex.Message);
            }

            decimal remainingBalance = totalIncome - totalExpenses;

            lblTotalIncome.Text = "Total Income: $" + totalIncome.ToString("F2");
            lblTotalExpenses.Text = "Total Expenses: $" + totalExpenses.ToString("F2");
            lblRemainingBalance.Text = "Remaining Balance: $" + remainingBalance.ToString("F2");
        }

        private void BtnAddClick(object sender, EventArgs e)
        {
            decimal amount;
            if (!decimal.TryParse(txtAmount.Text, out amount))
            {
                MessageBox.Show("Please enter a valid numeric amount.", "Input Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            TransactionModel transaction = new TransactionModel
            {
                Amount = amount,
                CategoryId = Convert.ToInt32(cmbCategory.SelectedValue),
                TypeId = Convert.ToInt32(cmbType.SelectedValue),
                Date = dtpDate.Value,
                Description = txtDescription.Text
            };

            string query = "INSERT INTO Transaction (Amount, CategoryID, Date, Description, TypeID) " +
                           "VALUES (@Amount, @CategoryID, @Date, @Description, @TypeID)";

            MySqlParameter[] parameters = {
                new MySqlParameter("@Amount", transaction.Amount),
                new MySqlParameter("@CategoryID", transaction.CategoryId),
                new MySqlParameter("@Date", transaction.Date.ToString("yyyy-MM-dd")),
                new MySqlParameter("@Description", transaction.Description),
                new MySqlParameter("@TypeID", transaction.TypeId)
            };

            dbManager.ExecuteNonQuery(query, parameters);
            MessageBox.Show("Transaction added successfully!");

            ClearInputs();
            LoadTransactions();
            UpdateSummary();
        }

        private void BtnDeleteClick(object sender, EventArgs e)
        {
            if (dgvTransactions.SelectedRows.Count == 0)
            {
                MessageBox.Show("Please select a transaction row from the table to delete.", "Selection Error", MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            int transactionID = Convert.ToInt32(dgvTransactions.SelectedRows[0].Cells["TransactionID"].Value);

            string query = "DELETE FROM Transaction WHERE TransactionID = @TransactionID";
            MySqlParameter[] parameters = {
                new MySqlParameter("@TransactionID", transactionID)
            };

            dbManager.ExecuteNonQuery(query, parameters);
            MessageBox.Show("Transaction deleted successfully!");

            LoadTransactions();
            UpdateSummary();
        }

        private void ClearInputs()
        {
            txtAmount.Clear();
            txtDescription.Clear();
            dtpDate.Value = DateTime.Now;
        }
    }
}
